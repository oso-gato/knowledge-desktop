#!/usr/bin/env python3
"""kd-marker (WP-12 ops oracle; A11) — paint and read the session's MARKER, lineage-agnostically.

The A11 observable (DESIGN §marker-a11 / V11: "all captures show the user's marker"): a user
connecting over the web door, native RDP and native VNC must land on ONE shared session. `kd-sessions
--census` proves the COUNT is 1; this proves the paths are looking at the SAME LIVE SCREEN — set a
marker once, and every path's capture must show it. Together they are the marker-a11 proof.

  kd-marker set <token>     paint this session's backdrop the colour derived from <token>
  kd-marker expect <token>  print the expected #RRGGBB — PURE, needs NO session (the capture
                            verifier runs this OUTSIDE the box to know what the pixels must be)
  kd-marker get             read back the colour currently applied to this session

  exit 0 = done/answered; 1 = could not apply/read (no session, or the desktop refused); 2 = usage

WHY A SOLID BACKDROP COLOUR (not a marker window): a full-screen solid colour is verifiable from ANY
capture by dominant-pixel colour alone — no toolkit, no window manager, no OCR, no font rendering,
and identical across the two lineages' very different compositors. A marker WINDOW would need a
toolkit in both images (a new dep on L2), could be obscured/moved by the WM, and would make the
verifier parse pixels for a shape instead of reading one colour.

MECHANISM — both lineages use ALREADY-INSTALLED tooling (N2: this adds no package):
  LINEAGE 1 (grd/Wayland/GNOME): the org.gnome.desktop.background GSettings — primary-color +
    color-shading-type=solid, with picture-uri cleared so the colour is what actually paints.
    Read/written through Gio (python3-gobject is already a permanent grd dep for the C4 governor).
  LINEAGE 2 (xrdp/X11/XFCE): the xfce4-desktop backdrop channel via `xfconf-query` (xfconf +
    xfdesktop are already in the image) — per-monitor `color-style=0` (solid), `image-style=0`
    (no wallpaper) and `rgba1` (the colour, as four 0..1 doubles).

The colour is a deterministic function of the token and is always VIVID (full saturation+value), so
it can never be confused with a default grey/black desktop. The derivation and the colour<->rgba
conversions are PURE and unit-tested in-box (shared/tests/kd-marker.test.sh); applying/reading a
live session is host-gate/COJOIN tier.
"""
import colorsys
import hashlib
import os
import re
import subprocess
import sys

BG_SCHEMA = "org.gnome.desktop.background"
XFCE_CHANNEL = "xfce4-desktop"


# ------------------------------------------------------------------ pure helpers (unit-tested)
def colour_for(token):
    """Deterministic, VIVID #RRGGBB for a marker token.

    The token picks a HUE; saturation and value are pinned to 1.0, so every marker is a fully
    saturated colour no default desktop background (grey/black/blue-grey) can be mistaken for. A
    raw hash slice would not do: it could land on near-black or near-white and make a capture
    check ambiguous."""
    if not token:
        raise ValueError("empty marker token")
    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
    hue = (int(digest[:8], 16) % 3600) / 3600.0
    r, g, b = colorsys.hsv_to_rgb(hue, 1.0, 1.0)
    return "#%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))


def hex_to_rgba(hexcolour):
    """'#RRGGBB' -> (r, g, b, 1.0) as 0..1 doubles (the xfconf rgba1 representation)."""
    m = re.fullmatch(r"#([0-9A-Fa-f]{6})", hexcolour.strip())
    if not m:
        raise ValueError("not a #RRGGBB colour: %r" % hexcolour)
    v = m.group(1)
    return tuple(int(v[i:i + 2], 16) / 255.0 for i in (0, 2, 4)) + (1.0,)


def rgba_to_hex(values):
    """The doubles xfconf prints back -> '#RRGGBB' (alpha ignored). Tolerates 3 or 4 values."""
    nums = [float(x) for x in values[:3]]
    if len(nums) < 3:
        raise ValueError("need 3 rgb components, got %r" % (values,))
    return "#%02X%02X%02X" % tuple(round(max(0.0, min(1.0, n)) * 255) for n in nums)


def backdrop_bases(prop_list_out):
    """From `xfconf-query -c xfce4-desktop -l` output return the per-monitor backdrop property
    BASES (e.g. '/backdrop/screen0/monitorrdp0/workspace0'), de-duplicated and sorted.

    XFCE exposes one property subtree per monitor+workspace; a session may have several. We derive
    the bases from whatever leaf properties exist rather than guessing monitor names (which differ
    between xorgxrdp outputs, physical outputs, and workspaces)."""
    bases = set()
    for line in prop_list_out.splitlines():
        line = line.strip()
        m = re.match(r"^(/backdrop/screen\d+/[^/]+/workspace\d+)/", line)
        if m:
            bases.add(m.group(1))
    return sorted(bases)


def parse_gsettings_colour(out):
    """`gsettings get org.gnome.desktop.background primary-color` -> '#RRGGBB' (it prints a quoted
    string). Returns None if the value is not a plain hex colour."""
    v = out.strip().strip("'\"")
    return v.upper() if re.fullmatch(r"#[0-9A-Fa-f]{6}", v) else None


# ------------------------------------------------------------------ live apply/read (host-gate)
def _is_wayland():
    return bool(os.environ.get("WAYLAND_DISPLAY")) or os.environ.get("XDG_SESSION_TYPE") == "wayland"


def _run(cmd):
    return subprocess.run(cmd, text=True, capture_output=True)


def _gnome_set(hexcolour):
    from gi.repository import Gio  # python3-gobject: already a permanent grd dep
    s = Gio.Settings.new(BG_SCHEMA)
    s.set_string("color-shading-type", "solid")
    s.set_string("primary-color", hexcolour)
    s.set_string("secondary-color", hexcolour)
    for key in ("picture-uri", "picture-uri-dark"):
        try:
            s.set_string(key, "")     # clear the wallpaper so the COLOUR is what paints
        except Exception:             # noqa: BLE001 — key absent on some GNOME versions
            pass
    Gio.Settings.sync()
    return True


def _gnome_get():
    from gi.repository import Gio
    return (Gio.Settings.new(BG_SCHEMA).get_string("primary-color") or "").upper() or None


def _xfce_set(hexcolour):
    listing = _run(["xfconf-query", "-c", XFCE_CHANNEL, "-l"])
    if listing.returncode != 0:
        return False
    bases = backdrop_bases(listing.stdout)
    if not bases:
        return False
    r, g, b, a = hex_to_rgba(hexcolour)
    applied = 0
    for base in bases:
        # color-style=0 -> solid colour; image-style=0 -> no wallpaper on top of it
        ok = True
        for prop, typ, val in (("color-style", "int", "0"), ("image-style", "int", "0")):
            ok &= _run(["xfconf-query", "-c", XFCE_CHANNEL, "-p", "%s/%s" % (base, prop),
                        "-n", "-t", typ, "-s", val]).returncode == 0
        cmd = ["xfconf-query", "-c", XFCE_CHANNEL, "-p", "%s/rgba1" % base, "-n"]
        for val in (r, g, b, a):
            cmd += ["-t", "double", "-s", "%.6f" % val]
        ok &= _run(cmd).returncode == 0
        applied += 1 if ok else 0
    return applied > 0


def _xfce_get():
    listing = _run(["xfconf-query", "-c", XFCE_CHANNEL, "-l"])
    if listing.returncode != 0:
        return None
    for base in backdrop_bases(listing.stdout):
        got = _run(["xfconf-query", "-c", XFCE_CHANNEL, "-p", "%s/rgba1" % base])
        if got.returncode == 0:
            vals = [v for v in got.stdout.split() if re.fullmatch(r"[0-9.]+", v)]
            if len(vals) >= 3:
                return rgba_to_hex(vals)
    return None


def main():
    a = sys.argv[1:]
    if a and a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if not a or a[0] not in ("set", "expect", "get") or (a[0] in ("set", "expect") and len(a) != 2) \
            or (a[0] == "get" and len(a) != 1):
        print("usage: kd-marker set <token> | expect <token> | get", file=sys.stderr)
        return 2
    mode = a[0]

    if mode == "expect":                      # PURE — no session needed, safe to run anywhere
        print(colour_for(a[1]))
        return 0

    wayland = _is_wayland()
    if mode == "set":
        colour = colour_for(a[1])
        try:
            ok = _gnome_set(colour) if wayland else _xfce_set(colour)
        except Exception as e:                # noqa: BLE001
            print("kd-marker: could not apply the marker (%s): %s"
                  % ("wayland" if wayland else "x11", e), file=sys.stderr)
            return 1
        if not ok:
            print("kd-marker: the desktop refused the marker (%s) — no backdrop property applied; "
                  "is a session running for this user?" % ("wayland" if wayland else "x11"),
                  file=sys.stderr)
            return 1
        print(colour)                          # echo the colour the verifier must see
        return 0

    try:                                       # get
        cur = _gnome_get() if wayland else _xfce_get()
    except Exception as e:                     # noqa: BLE001
        print("kd-marker: could not read the marker: %s" % e, file=sys.stderr)
        return 1
    if not cur:
        print("kd-marker: no marker colour readable (no session, or none set)", file=sys.stderr)
        return 1
    print(cur)
    return 0


if __name__ == "__main__":
    sys.exit(main())
